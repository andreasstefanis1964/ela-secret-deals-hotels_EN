        {
          "_name": "form1",
          "_sourceTheme": "elevatem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1 elevatem5\" group=\"Forms\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Form BG\" value=\"#ffffff\" name=\"form\" selected>\n        <input type=\"color\" title=\"Form Border\" value=\"#bbbbbb\" name=\"border\" selected>\n        <header>List</header>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"Stylized\" name=\"stylizedCounters\" condition=\"showList\" checked>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#125f94\" condition=\"showList\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/elevatem5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#eaeaea\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/elevatem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"list-wrapper\">\n                    <div class=\"text-wrap\">\n                        <h2 class=\"mbr-title mbr-fonts-style\" data-app-selector=\".mbr-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                            <b>You're one step away.</b></h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Following steps needed to get access to the world. No waiting time. No fees.</p>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"showList\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">Fill out the \"Quick free registration\"</li>\n                            <li class=\"item-wrap\">You receive from Rate Hawk your invitation for \"ela secret deals\"</li>\n                            <li class=\"item-wrap\">You enter your <b>own password</b> and you install the <b>mobile app</b></li>\n                            <li class=\"item-wrap\">You login with your own credentials and <b>download the extension</b></li>\n                            <li class=\"item-wrap\">You start <b>searching</b> hotels worldwide</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div mbr-form class=\"col-12 col-lg-5 mx-auto mbr-form\">\n                <form action=\"book@secret-deals-hotels.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"book@secret-deals-hotels.com\">\n                    <div class=\"row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out\n                            the form! We will create now your own ela secret deals account in Rate Hawk platform, so you will receive from Rate Hawk an invitation in order to set up your personal password. Please don´t forget to install also the mobile app, as well as the web extension (see above).  \n\nAfter ogin you can start searching and booking our room(s) in one of the 2.7 mio. hotels worldwide.\n\nWe hope you will enjoy your journey!\nBest regards\n\nYour Team from ela Secret deals &amp; Rate Hawk!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some\n                            problem!\n                        </div>\n                    </div>\n                    <div class=\"dragArea row\">\n                        <div class=\"col-12\">\n                            <h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\">\n                                <b>Quick free registration</b></h3>\n                        </div>\n                        <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"text\">\n                            <label mbr-text mbr-theme-style=\"display-4\" for=\"text\" class=\"form-control-label mbr-fonts-style\"><b>First name*</b></label>\n                            <input type=\"text\" name=\"text\" placeholder=\"Enter your first name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"text1\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\">\n                            <label mbr-text mbr-theme-style=\"display-4\" for=\"text1\" class=\"form-control-label mbr-fonts-style\"><b>Last name*</b></label>\n                            <input type=\"text\" name=\"text1\" placeholder=\"Enter your last name\" data-form-field=\"text1\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <label mbr-text mbr-theme-style=\"display-4\" for=\"email\" class=\"form-control-label mbr-fonts-style\"><b>Email*</b></label>\n                            <input type=\"email\" name=\"email\" placeholder=\"Enter your own email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"text2\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <label mbr-text mbr-theme-style=\"display-4\" for=\"text2\" class=\"form-control-label mbr-fonts-style\"><b>Company name*</b></label>\n                            <input type=\"text\" name=\"text2\" placeholder=\"Enter your company name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"select\" hidden=\"hidden\">\n                            <label mbr-text mbr-theme-style=\"display-4\" for=\"select\" class=\"form-control-label mbr-fonts-style\" hidden=\"hidden\"><b>Business Type*</b></label>\n                            <select name=\"select\" data-form-field=\"select\" mbr-theme-style=\"display-7\" class=\"form-control\" hidden=\"hidden\">\n                                <option value=\"Catering\">Catering</option>\n                                <option value=\"Delivery Fleet\">Delivery Fleet</option>\n                                <option value=\"Florist\">Florist</option>\n                            </select>\n                        </div>\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"textarea\">\n                            <label mbr-text mbr-theme-style=\"display-4\" for=\"textarea\" class=\"form-control-label mbr-fonts-style\"><b>Your mobile phone</b></label>\n                            <textarea name=\"textarea\" placeholder=\"Please enter with +\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n                        </div>\n                        <div mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-12 col-md-auto mbr-section-btn\"><a type=\"submit\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">Send Registration</a></div>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".list-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "height": "100%",
              ".text-wrap": {
                ".mbr-title": {
                  "margin-bottom": "30px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "30px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                }
              },
              ".list-wrap": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".list": {
                  "margin": "0",
                  "list-style": "none",
                  "padding-left": "32px",
                  "& when not (@stylizedCounters)": {
                    "padding-left": "0"
                  },
                  ".item-wrap": {
                    "margin-bottom": "30px",
                    "position": "relative",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "20px"
                    },
                    "& when (@stylizedCounters)": {
                      "list-style": "none",
                      "position": "relative",
                      "padding-left": "20px",
                      "&:before": {
                        "position": "absolute",
                        "left": "-32px",
                        "display": "flex",
                        "justify-content": "center",
                        "align-items": "center",
                        "color": "@iconColor",
                        "background-color": "transparent",
                        "border": "3px solid @iconColor",
                        "width": "32px",
                        "height": "32px",
                        "border-radius": "50%",
                        "font-weight": "600",
                        "font-size": "24px",
                        "content": "\"✓\""
                      }
                    },
                    "& when not (@stylizedCounters)": {
                      "padding-left": "0"
                    }
                  }
                }
              }
            },
            ".dragArea.row": {
              "background-color": "@form",
              "padding": "40px 30px",
              "border-radius": "16px",
              "@media (max-width: 992px)": {
                "padding": "20px 16px",
                "margin": "0"
              },
              ".mbr-section-title": {
                "margin-bottom": "40px"
              },
              ".form-group": {
                "margin-bottom": "20px !important",
                ".form-control-label": {
                  "padding-left": "8px",
                  "margin-bottom": "6px"
                },
                ".form-control": {
                  "padding": "14px",
                  "border": "1px solid @border !important",
                  "box-shadow": "none",
                  "background-color": "transparent",
                  "&:hover, &:focus": {
                    "border": "1px solid @border !important",
                    "box-shadow": "none"
                  }
                },
                ".form-check": {
                  "padding-left": "2rem",
                  ".form-check-input:checked": {
                    "background-color": "@secondaryColor",
                    "border-color": "@secondaryColor"
                  }
                }
              },
              ".mbr-section-btn": {
                "width": "100%",
                "margin-top": "30px"
              }
            },
            ".mbr-title": {
              "color": "#125f94"
            },
            ".mbr-section-title": {
              "color": "#08323C",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#08323C"
            },
            ".mbr-text": {
              "color": "#caa912"
            },
            ".list": {
              "color": "#08323C"
            },
            "label": {
              "color": "#08323C"
            },
            "H3": {
              "color": "#caa912"
            }
          },
