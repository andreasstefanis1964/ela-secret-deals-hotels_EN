            ".image-wrapper": {
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "img": {
                "height": "600px",
                "object-fit": "cover",
                "border-radius": "40px !important",
                "@media (max-width: 992px)": {
                  "height": "350px"
                }
              }
