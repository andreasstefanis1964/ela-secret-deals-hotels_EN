            ".form-wrapper": {
              ".row.dragArea": {
                ".mbr-section-title": {
                  "margin-bottom": "16px !important"
                },
                ".mbr-text": {
                  "margin-bottom": "32px !important"
                },
                ".form-group": {
                  "margin-bottom": "32px !important",
                  ".form-control": {
                    "background-color": "@input",
                    "padding": "32px",
                    "box-shadow": "none",
                    "border": "2px solid transparent !important",
                    "border-radius": "16px !important",
                    "transition": "all 0.3s ease-in-out",
                    "@media (max-width: 992px)": {
