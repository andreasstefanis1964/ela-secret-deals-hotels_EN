                    ".mbr-iconfont": {
                      "width": "40px",
                      "height": "40px",
                      "min-width": "40px",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "border-radius": "50%",
                      "font-size": "18px",
                      "color": "@card",
                      "background-color": "@icon",
                      "margin-left": "10px",
                      "transition": "all 0.3s ease-in-out"
