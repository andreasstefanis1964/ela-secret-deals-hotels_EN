        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 24px"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              ".decor-wrap": {
                "position": "absolute",
                "bottom": "-16rem",
                "right": "-58rem",
                "border": "120px solid @decor",
                "width": "2000px",
                "height": "1000px",
                "border-radius": "100%",
                "@media (max-width: 768px)": {
                  "height": "500px"
                }
              },
              ".mbr-emoji": {
                "position": "absolute",
                "width": "128px",
                "height": "128px",
                "border-radius": "24px",
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "margin-bottom": "0",
                "box-shadow": "0px 0px 5px @border",
                "@media (max-width: 992px)": {
                  "display": "none"
                },
                "&.emoji_1": {
                  "top": "0",
                  "left": "0",
                  "background-color": "@color_1",
                  "transform": "rotate(10deg)"
                },
                "&.emoji_2": {
                  "top": "0",
                  "right": "14rem",
                  "background-color": "@color_2",
                  "transform": "rotate(-10deg)",
                  "@media (max-width: 1200px)": {
                    "right": "8rem"
                  }
                },
                "&.emoji_3": {
                  "bottom": "0",
                  "right": "4rem",
                  "background-color": "@color_3",
                  "transform": "rotate(-10deg)"
                },
                "&.emoji_4": {
                  "bottom": "0",
                  "left": "10rem",
                  "background-color": "@color_4",
                  "transform": "rotate(10deg)"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "700px",
                      "object-fit": "cover",
                      "border-radius": "1rem !important",
                      "@media (max-width: 768px)": {
                        "height": "420px",
                        "border-radius": "10px !important"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "30px",
              "height": "30px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@border !important",
              "border": "none",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@border",
                "opacity": ".7"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "z-index": "5",
              "width": "400px",
              "border": "26px solid @border",
              "border-radius": "3rem",
              "background-color": "@border",
              "@media (max-width: 768px)": {
                "width": "300px",
                "border": "18px solid @border",
                "border-radius": "2rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "smartm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla smartm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showDecor\" title=\"Decoration\" checked=\"\">\n        <input type=\"color\" name=\"decor\" title=\"Decoration Color\" value=\"#FF3399\" condition=\"showDecor\">\n        <input type=\"checkbox\" name=\"showEmoji\" title=\"Emoji\" checked=\"\">\n        <input type=\"color\" name=\"color_1\" title=\"Emoji Color 1\" value=\"#00CCBD\" condition=\"showEmoji\">\n        <input type=\"color\" name=\"color_2\" title=\"Emoji Color 2\" value=\"#4a8dff\" condition=\"showEmoji\">\n        <input type=\"color\" name=\"color_3\" title=\"Emoji Color 3\" value=\"#e5faf9\" condition=\"showEmoji\">\n        <input type=\"color\" name=\"color_4\" title=\"Emoji Color 4\" value=\"#990066\" condition=\"showEmoji\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"color\" name=\"border\" title=\"Border Color\" value=\"#262642\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#F5DF4D\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F5DF4D\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"decor-wrap\" mbr-if=\"showDecor\"></div>\n                    <p class=\"mbr-emoji emoji_1 mbr-fonts-style\" data-app-selector=\".mbr-emoji\" mbr-theme-style=\"display-2\" mbr-if=\"showEmoji\">\n                        🚗\n                    </p>\n                    <p class=\"mbr-emoji emoji_2 mbr-fonts-style\" data-app-selector=\".mbr-emoji\" mbr-theme-style=\"display-2\" mbr-if=\"showEmoji\">\n                        🏃‍♂️\n                    </p>\n                    <p class=\"mbr-emoji emoji_3 mbr-fonts-style\" data-app-selector=\".mbr-emoji\" mbr-theme-style=\"display-2\" mbr-if=\"showEmoji\">\n                        ⛺️\n                    </p>\n                    <p class=\"mbr-emoji emoji_4 mbr-fonts-style\" data-app-selector=\".mbr-emoji\" mbr-theme-style=\"display-2\" mbr-if=\"showEmoji\">\n                        🌷\n                    </p>\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/image6.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/image10.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/image8.jpg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "tMfe4F1j8G",
