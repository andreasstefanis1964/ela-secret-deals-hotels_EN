            ".content-wrapper": {
              "padding-right": "80px",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "80px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "0",
                "margin-bottom": "32px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
