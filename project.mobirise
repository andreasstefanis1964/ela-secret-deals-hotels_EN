                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".content-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-text": {
                "margin-bottom": "16px"
              }
            },
            ".form-wrap": {
              ".dragArea.row": {
                ".mbr-section-title": {
                  "margin-bottom": "16px !important"
                },
                ".mbr-text": {
                  "margin-bottom": "16px"
                },
                ".form-group": {
                  "margin-bottom": "16px !important",
                  ".form-control": {
                    "padding": "16px",
                    "border": "1px solid @border !important",
                    "box-shadow": "none",
                    "border-radius": "0 !important",
                    "background-color": "transparent",
                    "&:hover, &:focus": {
                      "border": "1px solid @active !important"
                    },
                    "&::placeholder": {
                      "color": "@active"
                    }
                  },
                  "textarea": {
                    "min-height": "150px"
                  },
                  ".form-check": {
                    "padding-left": "1.9em",
                    "margin-bottom": "16px",
                    ".form-check-input": {
                      "background-color": "transparent",
                      "border-color": "@border",
                      "border-radius": "0",
                      "&:focus": {
                        "background-color": "@border"
                      }
                    }
                  }
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "margin-top": "16px",
                    "min-height": "auto"
                  }
                }
              }
            },
