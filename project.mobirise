              "img": {
                "height": "600px",
                "object-fit": "cover",
                "border-radius": "40px !important",
                "@media (max-width: 992px)": {
                  "height": "350px"
                }
              }
            },
            ".content-wrapper": {
              "padding-right": "80px",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "80px",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              ".title-wrapper": {
                "margin-bottom": "64px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                "@media (max-width: 768px)": {
                  "margin-bottom": "32px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "16px"
                },
                ".mbr-section-subtitle": {
                  "margin-bottom": "0"
                }
              },
              ".items-wrapper": {
                ".item": {
                  "margin-bottom": "32px",
                  "&:nth-child(2n)": {
                    ".item-wrapper .card-box .iconfont-wrapper .mbr-iconfont": {
                      "color": "@color_2",
                      "background-color": "@bg_2"
                    }
                  },
                  "&:nth-child(3n)": {
                    ".item-wrapper .card-box .iconfont-wrapper .mbr-iconfont": {
                      "color": "@color_3",
                      "background-color": "@bg_3"
                    }
                  },
                  ".item-wrapper": {
                    ".card-box": {
                      "display": "flex",
                      ".iconfont-wrapper": {
                        "margin-right": "24px",
                        "@media (max-width: 992px)": {
                          "margin-right": "16px"
                        },
                        ".mbr-iconfont": {
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "width": "56px",
                          "height": "56px",
                          "min-width": "56px",
                          "border-radius": "16px",
                          "font-size": "24px",
                          "color": "@color_1",
                          "background-color": "@bg_1"
                        }
                      },
                      ".card-text": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#125f94"
            },
